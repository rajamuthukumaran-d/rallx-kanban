generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id                 String             @id @default(cuid())
  name               String
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  memberships        Membership[]
  projects           Project[]
  integrations       Integration[]
  mcpTokens          McpToken[]
  identityProviders  IdentityProvider[]
  githubSyncs        GithubSync[]
  auditEvents        AuditEvent[]
  tickets            Ticket[]
  comments           Comment[]
  attachments        Attachment[]
  ticketHistory      TicketHistory[]

  @@index([createdAt])
}

model User {
  id              String       @id @default(cuid())
  email           String       @unique
  name            String
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  memberships     Membership[]
  comments        Comment[]    @relation("CommentAuthor")
  auditEvents     AuditEvent[] @relation("AuditActor")
  attachments     Attachment[] @relation("AttachmentUploader")
  ticketHistory   TicketHistory[] @relation("TicketHistoryActor")
}

model Membership {
  id                   String          @id @default(cuid())
  tenantId             String
  userId               String
  role                 String          @default("member")
  createdAt            DateTime        @default(now())
  tenant               Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user                 User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignedTickets      Ticket[]        @relation("TicketAssignee")
  authoredComments     Comment[]       @relation("CommentAuthorMembership")
  auditEvents          AuditEvent[]    @relation("AuditActorMembership")
  uploadedAttachments  Attachment[]    @relation("AttachmentUploaderMembership")
  ticketHistory        TicketHistory[] @relation("TicketHistoryActorMembership")

  @@unique([tenantId, userId])
  @@index([userId])
}

model Project {
  id          String    @id @default(cuid())
  tenantId    String
  key         String
  name        String
  description String?
  archivedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tickets     Ticket[]

  @@unique([tenantId, id])
  @@unique([tenantId, key])
  @@index([tenantId, archivedAt])
}

model Ticket {
  id                String          @id @default(cuid())
  tenantId          String
  projectId         String
  key               String
  title             String
  description       String          @default("")
  status            String          @default("backlog")
  priority          String          @default("medium")
  lifecycle         String          @default("open")
  position          Int             @default(0)
  version           Int             @default(1)
  storyPoints       Int             @default(0)
  tags              String[]
  assigneeId        String?
  resolvedAt        DateTime?
  archivedAt        DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  tenant            Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  project           Project         @relation(fields: [tenantId, projectId], references: [tenantId, id], onDelete: Cascade)
  assignee          Membership?     @relation("TicketAssignee", fields: [tenantId, assigneeId], references: [tenantId, userId], onDelete: Restrict)
  comments          Comment[]
  attachments       Attachment[]
  history           TicketHistory[]
  githubSync        GithubSync?

  @@unique([tenantId, id])
  @@unique([tenantId, projectId, key])
  @@index([tenantId, projectId, status, position])
  @@index([tenantId, projectId, lifecycle])
  @@index([tenantId, assigneeId])
}

model Comment {
  id          String       @id @default(cuid())
  tenantId    String
  ticketId    String
  authorId    String
  parentId    String?
  body        String
  resolvedAt  DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ticket      Ticket      @relation(fields: [tenantId, ticketId], references: [tenantId, id], onDelete: Cascade)
  author      User         @relation("CommentAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  authorMember Membership  @relation("CommentAuthorMembership", fields: [tenantId, authorId], references: [tenantId, userId], onDelete: Cascade)
  parent      Comment?     @relation("CommentReplies", fields: [tenantId, parentId], references: [tenantId, id], onDelete: Cascade)
  replies     Comment[]    @relation("CommentReplies")

  @@unique([tenantId, id])
  @@index([tenantId, ticketId, createdAt])
  @@index([tenantId, parentId])
}

model Attachment {
  id              String       @id @default(cuid())
  tenantId        String
  ticketId        String
  uploaderId      String?
  name            String
  storageKey       String
  mimeType         String
  sizeBytes       BigInt
  createdAt       DateTime     @default(now())
  tenant          Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ticket          Ticket       @relation(fields: [tenantId, ticketId], references: [tenantId, id], onDelete: Cascade)
  uploader        User?        @relation("AttachmentUploader", fields: [uploaderId], references: [id], onDelete: Restrict)
  uploaderMember  Membership?  @relation("AttachmentUploaderMembership", fields: [tenantId, uploaderId], references: [tenantId, userId], onDelete: Restrict)

  @@unique([tenantId, ticketId, storageKey])
  @@index([tenantId, ticketId, createdAt])
}

model TicketHistory {
  id          String       @id @default(cuid())
  tenantId    String
  ticketId    String
  actorId     String?
  action      String
  fromValue   Json?
  toValue     Json?
  createdAt   DateTime     @default(now())
  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ticket      Ticket       @relation(fields: [tenantId, ticketId], references: [tenantId, id], onDelete: Cascade)
  actor       User?        @relation("TicketHistoryActor", fields: [actorId], references: [id], onDelete: Restrict)
  actorMember Membership? @relation("TicketHistoryActorMembership", fields: [tenantId, actorId], references: [tenantId, userId], onDelete: Restrict)

  @@index([tenantId, ticketId, createdAt])
}

model AuditEvent {
  id          String       @id @default(cuid())
  tenantId    String
  actorId     String?
  action      String
  resource    String
  resourceId  String?
  metadata    Json?
  createdAt   DateTime     @default(now())
  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  actor       User?        @relation("AuditActor", fields: [actorId], references: [id], onDelete: Restrict)
  actorMember Membership? @relation("AuditActorMembership", fields: [tenantId, actorId], references: [tenantId, userId], onDelete: Restrict)

  @@index([tenantId, createdAt])
  @@index([tenantId, resource, resourceId])
}

model Integration {
  id         String        @id @default(cuid())
  tenantId   String
  provider   String
  externalId String?
  status     String        @default("pending")
  config     Json?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  tenant     Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  githubSyncs GithubSync[]

  @@unique([tenantId, id])
  @@unique([tenantId, provider])
  @@index([tenantId, status])
}

model McpToken {
  id         String    @id @default(cuid())
  tenantId   String
  name       String
  tokenHash  String    @unique
  scopes     String[]
  lastUsedAt DateTime?
  expiresAt  DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
  tenant     Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, revokedAt])
}

model IdentityProvider {
  id         String   @id @default(cuid())
  tenantId   String
  provider   String
  issuer     String
  clientId   String
  secretRef  String?
  enabled    Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, provider])
  @@index([tenantId, enabled])
}

model GithubSync {
  id                String       @id @default(cuid())
  tenantId          String
  ticketId          String
  integrationId     String?
  repository        String
  pullRequestNumber Int?
  issueNumber       Int?
  externalNodeId    String?
  state             String       @default("pending")
  lastSyncedAt      DateTime?
  lastError         String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  tenant            Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ticket            Ticket       @relation(fields: [tenantId, ticketId], references: [tenantId, id], onDelete: Cascade)
  integration       Integration? @relation(fields: [tenantId, integrationId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, id])
  @@unique([tenantId, ticketId])
  @@unique([tenantId, repository, pullRequestNumber])
  @@index([tenantId, state, lastSyncedAt])
}
