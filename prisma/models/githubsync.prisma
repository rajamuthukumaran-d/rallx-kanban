model GithubSync {
  id                String       @id @default(cuid())
  tenantId          String
  ticketId          String
  integrationId     String?
  repository        String
  pullRequestNumber Int?
  issueNumber       Int?
  externalNodeId    String?
  state             String       @default("pending")
  lastSyncedAt      DateTime?
  lastError         String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  tenant            Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ticket            Ticket       @relation(fields: [tenantId, ticketId], references: [tenantId, id], onDelete: Cascade)
  integration       Integration? @relation(fields: [tenantId, integrationId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, id])
  @@unique([tenantId, ticketId])
  @@unique([tenantId, repository, pullRequestNumber])
  @@index([tenantId, state, lastSyncedAt])
}
