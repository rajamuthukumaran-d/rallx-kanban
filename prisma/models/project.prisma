model Project {
  id          String    @id @default(cuid())
  tenantId    String
  key         String
  name        String
  description String?
  archivedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tickets     Ticket[]

  @@unique([tenantId, id])
  @@unique([tenantId, key])
  @@index([tenantId, archivedAt])
}
