model Ticket {
  id                String          @id @default(cuid())
  tenantId          String
  projectId         String
  key               String
  title             String
  description       String          @default("")
  status            String          @default("backlog")
  priority          String          @default("medium")
  lifecycle         String          @default("open")
  position          Int             @default(0)
  version           Int             @default(1)
  storyPoints       Int             @default(0)
  tags              String[]
  assigneeId        String?
  resolvedAt        DateTime?
  archivedAt        DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  tenant            Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  project           Project         @relation(fields: [tenantId, projectId], references: [tenantId, id], onDelete: Cascade)
  assignee          Membership?     @relation("TicketAssignee", fields: [tenantId, assigneeId], references: [tenantId, userId], onDelete: Restrict)
  comments          Comment[]
  attachments       Attachment[]
  history           TicketHistory[]
  githubSync        GithubSync?

  @@unique([tenantId, id])
  @@unique([tenantId, projectId, key])
  @@index([tenantId, projectId, status, position])
  @@index([tenantId, projectId, lifecycle])
  @@index([tenantId, assigneeId])
}
